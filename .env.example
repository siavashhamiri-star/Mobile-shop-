# ========================================================
# NIKO MOBILE - SECURE ENVIRONMENT TEMPLATE
# ========================================================
# IMPORTANT SECURITY GUIDELINE:
# - NEVER commit real keys, tokens or passwords to git.
# - In Production & CI/CD, configure these via GitHub Secrets
#   or Cloud Secret Manager (e.g. GEMINI_API_KEY).
# ========================================================

# GEMINI_API_KEY: Used for server-side AI processing (if enabled)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Production origin URL of the hosted application
APP_URL="https://nikomobile.ir"

# ANDROID KEYSTORE (FOR SIGNED APK IN CI/CD):
# SIGNING_KEYSTORE_BASE64="BASE64_ENCODED_KEYSTORE_FILE"
# KEYSTORE_PASSWORD="KEYSTORE_PASSWORD"
# KEY_ALIAS="KEY_ALIAS"
# KEY_PASSWORD="KEY_PASSWORD"
